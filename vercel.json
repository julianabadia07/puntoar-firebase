{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/manual", "destination": "/manual/puntoar-manual.html" },
    { "source": "/manual/(.*)", "destination": "/manual/puntoar-manual.html" },
    { "source": "/seed", "destination": "/seed.html" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/public/index.html" }
  ]
}
